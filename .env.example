DATABASE_URL=postgresql://username:password@localhost:5432/music_operations
ENGINE_API_KEY=replace-with-a-random-secret-at-least-32-characters
PORT=4000
# CORS_ORIGIN=https://your-command-center.example
# ENGINE_CREDENTIALS is a JSON array of server-side credentials, never browser configuration.
# Each entry: {"id":"command-center","key":"<random-secret-at-least-32-characters>","labels":["label-id"],"permissions":["read"]}
# Optional sources allowlist applies to ingestion and reporting.
# TRACKZERO_WEBHOOK_SECRET=<random-source-signing-secret-at-least-32-characters>
# SCENESIGNAL_WEBHOOK_SECRET=<different-random-signing-secret-at-least-32-characters>

# Required before storing provider credentials: 32 random bytes encoded as base64, held in the deployment secret manager.
# CONNECTOR_MASTER_KEY=<base64-encoded-32-byte-key>

# Optional in-process job worker (inline ingest jobs only; sources without a handler stay queued).
# WORKER_ENABLED=1
# WORKER_SOURCES=manual
# WORKER_INTERVAL_MS=15000
# Behind a trusted reverse proxy (e.g. Render), rate limits key on the forwarded client address.
# TRUST_PROXY=1

# Command Center console credential (read/ingest/manage, system-wide; may send X-Acting-User for audit attribution).
# ENGINE_CONSOLE_KEY=<random-secret-at-least-32-characters>
# Alert delivery (OFF until set). The in-app feed is always on.
# ALERT_WEBHOOK_URL=https://hooks.example/alerts
# ALERT_WEBHOOK_SECRET=<random-secret>
# ALERT_EMAIL_TO=ops@example.com
# ALERT_EMAIL_FROM=alerts@example.com
# RESEND_API_KEY=<resend-api-key>
# ALERT_EVAL_INTERVAL_MS=300000
# Live provider pulls (OFF until set; currently only youtube has a public reporting API). Also add the provider to WORKER_SOURCES.
# PROVIDER_LIVE_PULLS=youtube
